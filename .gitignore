data/
outputs/
output/
logs/
runs/
wandb/
tensorboard/

# Model checkpoints / generated arrays / heavy artifacts
*.pth
*.pt
*.ckpt
*.npy
*.npz
*.ply
*.splat
*.splat4d

# Rendered images / videos / intermediate render products
# Do not ignore *.png globally, because documentation or sample images may be intentional.
*.mp4
*.mov
*.avi
*.mkv
*.exr
*.tiff
*.tif

# Python / packaging / build metadata
*.egg-info/
*.dist-info/
*.egg
build/
dist/
.eggs/
__pycache__/
